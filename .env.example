SITE_URL=https://chenyc.chat
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=studio
DB_PASSWORD=
DB_DATABASE=ai_studio
ALLOW_REGISTRATION=true
# Production HTTPS: true. Set false only for local HTTP verification.
COOKIE_SECURE=true
# Enable only behind a proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Image generation uses its own provider and key. Blank URL uses the local 4981 service.
# The gateway must return b64_json; temporary URL-only responses are rejected.
IMAGE_API_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=gemini-3-pro-image
# Preserve the existing gateway-compatible square request by default.
# Use portrait/landscape sizes only after confirming the selected gateway supports them.
IMAGE_SIZE_COVER=1024x1024
IMAGE_SIZE_CHARACTER=1024x1024
IMAGE_SIZE_SCENE=1024x1024
IMAGE_TIMEOUT_MS=85000
# Optional trusted fallback. Credentials are never copied from the primary provider.
# Only explicit upstream 429/5xx responses can trigger fallback, never timeouts.
IMAGE_FALLBACK_BASE_URL=
IMAGE_FALLBACK_API_KEY=
IMAGE_FALLBACK_MODEL=
# Optional persistent generated image directory (the root containing workflow/).
GENERATED_ASSET_DIR=
UPSTREAM_BALANCED_MODEL=
UPSTREAM_SPEED_MODEL=
UPSTREAM_ULTRA_MODEL=
CHAT_DAILY_REQUESTS=100
CHAT_MAX_OUTPUT_TOKENS=2048
QUANT_API_URL=http://127.0.0.1:8100
# Set local only for a content preview. Production uses the migrated MySQL posts table.
CONTENT_SOURCE=database
